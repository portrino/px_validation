#
# Example validation rules using EXT:px_validation (TYPO3 v14 structured notation)
#
plugin.tx_pxvalidation.settings {
    Portrino\PxRegister\Controller\UserController {
        createAction {
            user {
                # NB: built-in (attribute) validators are suppressed per MODEL via
                # plugin.tx_pxvalidation.settings.suppressBaseValidation, not here.
                # The FrontendUser model carries no #[Validate] attributes, so nothing
                # needs to be suppressed; the rules below run additively.
                objectValidators {
                    0 {
                        validator = Portrino\PxRegister\Domain\Validator\PropertyUniqueValidator
                        options {
                            property = email
                            ignoreEnableFields = true
                        }
                    }
                    1 {
                        validator = Portrino\PxRegister\Domain\Validator\PropertyCompareValidator
                        options {
                            firstProperty = newPassword
                            secondProperty = newPasswordRepeat
                            operator = equal
                        }
                    }
                }
                propertyValidators {
                    email {
                        0.validator = NotEmpty
                        1.validator = EmailAddress
                    }
                    salutation {
                        0.validator = NotEmpty
                    }
                    firstName {
                        0.validator = NotEmpty
                    }
                    lastName {
                        0.validator = NotEmpty
                    }
                    newPassword {
                        0.validator = NotEmpty
                        1 {
                            validator = StringLength
                            options.minimum = 8
                        }
                        #2 {
                        #    validator = Portrino\PxRegister\Domain\Validator\PasswordStrengthValidator
                        #    options {
                        #        includesNumber = true
                        #        includesLetter = true
                        #        includesCapitalLetter = true
                        #        includesSymbol = true
                        #    }
                        #}
                    }
                    terms {
                        0 {
                            validator = Boolean
                            options.is = true
                        }
                    }
                    #captchaResponse {
                    #    0 {
                    #        validator = Portrino\SitePackage\Domain\Validator\CaptchaValidator
                    #        options.after = 0
                    #    }
                    #}
                }
            }
        }
        updateAction {
            user {
                objectValidators {
                    0 {
                        validator = Portrino\PxRegister\Domain\Validator\PropertyUniqueValidator
                        options {
                            property = emailChanged
                            ignoreEnableFields = true
                        }
                    }
                }
                propertyValidators {
                    username {
                        0.validator = NotEmpty
                    }
                    emailChanged {
                        0.validator = NotEmpty
                        1.validator = EmailAddress
                    }
                    salutation {
                        0.validator = NotEmpty
                    }
                    firstName {
                        0.validator = NotEmpty
                    }
                    lastName {
                        0.validator = NotEmpty
                    }
                }
            }
        }
        updatePasswordAction {
            user {
                objectValidators {
                    0 {
                        validator = Portrino\PxRegister\Domain\Validator\PasswordCheckValidator
                    }
                    1 {
                        validator = Portrino\PxRegister\Domain\Validator\PropertyCompareValidator
                        options {
                            firstProperty = newPassword
                            secondProperty = newPasswordRepeat
                            operator = equal
                        }
                    }
                }
                propertyValidators {
                    newPassword {
                        0.validator = NotEmpty
                        1 {
                            validator = StringLength
                            options.minimum = 8
                        }
                        #2 {
                        #    validator = Portrino\PxRegister\Domain\Validator\PasswordStrengthValidator
                        #    options {
                        #        includesNumber = true
                        #        includesLetter = true
                        #        includesCapitalLetter = true
                        #        includesSymbol = true
                        #    }
                        #}
                    }
                }
            }
        }
        deleteAction {
            user {
                objectValidators {
                    0 {
                        validator = Portrino\PxRegister\Domain\Validator\PasswordCheckValidator
                    }
                }
            }
        }
    }
}
